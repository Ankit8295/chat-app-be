# Chat service runtime image.
# Build first:  .\gradlew.bat :chat:bootJar -x test
# Then:         docker compose -f infra/compose.yml up --build
FROM eclipse-temurin:21-jre

WORKDIR /app

COPY services/chat/build/libs/chat-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8081

ENTRYPOINT ["java", "-jar", "app.jar"]
