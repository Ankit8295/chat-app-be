# User service runtime image.
# Build first:  .\gradlew.bat :user:bootJar -x test
# Then:         docker compose -f infra/compose.yml up --build
FROM eclipse-temurin:21-jre

WORKDIR /app

COPY services/user/build/libs/user-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8084

ENTRYPOINT ["java", "-jar", "app.jar"]
