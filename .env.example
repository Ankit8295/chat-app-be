# Example env vars for running a single service locally (e.g. .\gradlew.bat :chat:bootRun).
# Each service (auth, user, chat) binds these the same way — override per service as needed.

SERVER_PORT=8081

DB_URL=jdbc:postgresql://localhost:5432/chat_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REALTIME_CHANNEL=chat:realtime
INSTANCE_ID=local

USER_SERVICE_BASE_URL=http://localhost:8084

CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/
JWT_ISSUER=the-chat-api
JWT_SECRET=replace-this-dummy-secret-with-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# Service-to-service token secret (Phase 5) — MUST be different from JWT_SECRET above, and MUST be
# the same value across auth/user/chat so they can verify each other's service tokens.
SERVICE_JWT_ISSUER=the-chat-internal
SERVICE_JWT_SECRET=replace-this-dummy-service-secret-with-at-least-32-chars
SERVICE_JWT_TTL=PT1M
