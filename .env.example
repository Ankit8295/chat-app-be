SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/the_chat
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REALTIME_CHANNEL=chat:realtime
INSTANCE_ID=local

CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/
JWT_ISSUER=the-chat-api
JWT_SECRET=replace-this-dummy-secret-with-at-least-32-characters
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D
