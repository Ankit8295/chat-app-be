# =============================================================================
# Production env for AWS Lightsail — copy to `.env` on the server (NEVER commit).
#   cp .env.production.example .env
#   chmod 600 .env
# Generate secrets with: openssl rand -base64 48
# =============================================================================

# --- Postgres superuser (init only) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Per-service DB users (must match init-databases.sh) ---
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
USER_DB_USER=user_svc
USER_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
CHAT_DB_USER=chat_svc
CHAT_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Redis ---
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- JWT (MUST be identical across auth/user/chat) ---
JWT_ISSUER=the-chat-api
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# --- Service-to-service JWT (DIFFERENT from JWT_SECRET; identical across services) ---
SERVICE_JWT_ISSUER=the-chat-internal
SERVICE_JWT_SECRET=REPLACE_WITH_DIFFERENT_AT_LEAST_32_CHAR_SECRET
SERVICE_JWT_TTL=PT1M

# --- Cookies / CORS (FE + API share ankitdev.in → SameSite=Lax works) ---
CORS_ALLOWED_ORIGINS=https://chat.ankitdev.in
AUTH_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_COOKIE_DOMAIN=.ankitdev.in

# --- Cloudflare R2 (user-service profile images) ---
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET_NAME=the-chat-profile-images
R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_R2_OR_CUSTOM_DOMAIN
R2_PUT_URL_TTL=PT15M
R2_GET_URL_TTL=PT5M

# --- Optional: backup script (infra/scripts/backup-postgres.sh) ---
# BACKUP_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# BACKUP_R2_BUCKET=the-chat-db-backups
# BACKUP_R2_ACCESS_KEY_ID=REPLACE
# BACKUP_R2_SECRET_ACCESS_KEY=REPLACE
